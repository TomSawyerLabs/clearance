{
  "name": "clearance",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bunx --bun vite build",
    "start": "bun src/entry/bun.ts",
    "compile": "bun scripts/compile.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "test:e2e": "bun run build && playwright test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "worker:dev": "bun run build && wrangler dev",
    "worker:deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.12",
    "kysely": "^0.29.6",
    "marked": "^18.0.14",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.71.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.146.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
