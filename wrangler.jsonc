// Cloudflare Workers deployment. See docs/deploy.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearance",
  "main": "src/entry/worker.ts",
  "compatibility_date": "2026-09-01",
  // pdf-lib and the WebAuthn library use a few Node built-ins (Buffer, zlib).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    // Unknown paths are pages of the single-page app...
    "not_found_handling": "single-page-application",
    // ...except the API, which always goes to the Worker.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clearance",
      // Replace with the id printed by `wrangler d1 create clearance`.
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
}
